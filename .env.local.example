# Firebase — copie este arquivo para .env.local e preencha com os dados
# do seu projeto (Console Firebase > Configurações do projeto > Seus apps).
# O arquivo .env.local NÃO vai para o git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# E-mail da conta de administrador. Quem logar com este e-mail vai pro painel admin.
VITE_ADMIN_EMAIL=

# Cloudinary (upload de fotos). Cloud name e um upload preset "unsigned".
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
