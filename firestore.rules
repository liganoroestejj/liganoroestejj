rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // É o administrador? (mesmo e-mail do VITE_ADMIN_EMAIL)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() == 'liganoroestejj@gmail.com';
    }

    function isOwner(cpf) {
      return request.auth != null
        && get(/databases/$(database)/documents/affiliates/$(cpf)).data.uid == request.auth.uid;
    }

    // Filiados — dados pessoais. Só o dono ou o admin leem.
    match /affiliates/{cpf} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      // Cria a própria filiação (uid precisa bater com quem está logado).
      // A filiação nasce SEMPRE pendente: status/validade/carteirinha só o
      // admin define ao confirmar o pagamento. Impede auto-ativação.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['validUntil', 'cardId']);
      // Admin altera qualquer campo; o dono edita os próprios dados de
      // cadastro (nome, nascimento, sexo, academia, faixa, tipo), a foto e o
      // contato/endereço. Ficam de fora: CPF (é o id do doc), uid, status,
      // validUntil e cardId — pagamento e emissão da carteirinha são do admin,
      // e liberar esses campos permitiria auto-ativação.
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'photoURL',
                 'fullName', 'birthDate', 'gender', 'academyId', 'belt', 'role', 'category',
                 'email', 'instagram', 'phone', 'address',
                 'neighborhood', 'zipCode', 'city', 'state'
               ]))
        // Refiliação: um atleta removido (status 'inactive') teve o CPF
        // liberado no cpfRegistry, então pode se cadastrar de novo. O doc usa
        // o CPF como id e já existe, logo o cadastro chega aqui como update —
        // e vale as mesmas restrições do create (nasce pendente, sem
        // carteirinha nem validade).
        || (request.auth != null
            && resource.data.status == 'inactive'
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pending'
            && !request.resource.data.keys().hasAny(['validUntil', 'cardId']));
      allow delete: if isAdmin();

      // Mensalidades.
      match /payments/{month} {
        allow read: if isAdmin() || isOwner(cpf);
        allow create: if isAdmin() || isOwner(cpf);  // mensalidade inicial / meses seguintes
        allow update, delete: if isAdmin();      // admin marca como pago
      }
    }

    // Índice público de CPFs: só informa existência, sem dados pessoais.
    match /cpfRegistry/{cpf} {
      allow get: if true;                        // checagem da Etapa 1
      allow list: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Carteirinhas públicas — leitura pública (validação via QR Code).
    // A carteirinha só é EMITIDA pelo admin (na confirmação do pagamento):
    // é isso que garante a autenticidade atestada pelo QR. O dono só pode
    // atualizar a própria foto — nunca status, validade ou emitir uma nova.
    match /publicCards/{cardId} {
      allow read: if true;
      allow create: if isAdmin();
      // O dono só espelha no card o que ele já pode editar no próprio
      // cadastro (foto, nome, faixa, academia, nascimento) — assim a
      // carteirinha não fica desatualizada. `status` e `validUntil`, que é o
      // que o QR Code atesta, continuam exclusivos do admin.
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'photoURL', 'fullName', 'belt', 'academyId', 'birthDate'
               ]));
      allow delete: if isAdmin();
    }

    // Inscrições do campeonato de Pádua (2ª etapa). O id do doc é o CPF, o
    // que garante uma inscrição por atleta. Guardamos só o vínculo e o
    // pagamento: os dados do atleta saem sempre da filiação, pelo CPF.
    match /paduaRegistrations/{cpf} {
      allow get: if isAdmin() || isOwner(cpf);
      allow list: if isAdmin();
      // O próprio filiado se inscreve. A inscrição nasce SEMPRE pendente:
      // confirmar o pagamento é do admin, igual à filiação.
      // Só compete quem está com a filiação ativa (anuidade confirmada pelo
      // admin). A validade em si é checada na tela; aqui barramos pendente e
      // removido, que é o que importa no servidor.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && isOwner(cpf)
        && get(/databases/$(database)/documents/affiliates/$(cpf)).data.status == 'active'
        && request.resource.data.cpf == cpf
        && request.resource.data.status == 'pending'
        // Peso declarado: obrigatório e dentro de limites plausíveis (kg).
        // Corrigir o peso é do admin, por isso update continua só dele.
        && request.resource.data.weight is number
        && request.resource.data.weight >= 10
        && request.resource.data.weight <= 250;
      allow update, delete: if isAdmin();
    }

    // CPF da inscrição de quem está logado (guardado em paduaViewers).
    function viewerCpf() {
      return get(/databases/$(database)/documents/paduaViewers/$(request.auth.uid)).data.cpf;
    }

    // Lista de inscritos do Open Pádua (pagos e pendentes), vista por
    // qualquer inscrito. O id do doc é o uid do atleta e o conteúdo é só o
    // que pode circular entre atletas (nome, academia, faixa, categoria,
    // idade) — sem CPF, contato nem foto.
    match /paduaParticipants/{uid} {
      allow read: if isAdmin()
        || (request.auth != null
            && (exists(/databases/$(database)/documents/paduaViewers/$(request.auth.uid))
                || exists(/databases/$(database)/documents/paduaParticipants/$(request.auth.uid))));
      // O próprio inscrito publica a sua linha ao abrir a lista, para
      // aparecer sem esperar o admin. Nome, academia, faixa e sexo têm que
      // bater com a filiação; idade e categorias são recalculadas pelo
      // admin a cada abertura da aba de inscrições. Apagar é só do admin.
      allow create, update: if isAdmin()
        || (request.auth != null
            && request.auth.uid == uid
            && exists(/databases/$(database)/documents/paduaViewers/$(uid))
            && get(/databases/$(database)/documents/paduaRegistrations/$(viewerCpf())).data.status in ['pending', 'paid']
            && request.resource.data.keys().hasOnly([
                 'uid', 'fullName', 'academyId', 'belt', 'gender',
                 'age', 'categoryId', 'category', 'weightClass'
               ])
            && request.resource.data.uid == uid
            && request.resource.data.fullName == get(/databases/$(database)/documents/affiliates/$(viewerCpf())).data.fullName
            && request.resource.data.academyId == get(/databases/$(database)/documents/affiliates/$(viewerCpf())).data.academyId
            && request.resource.data.belt == get(/databases/$(database)/documents/affiliates/$(viewerCpf())).data.belt
            && request.resource.data.gender == get(/databases/$(database)/documents/affiliates/$(viewerCpf())).data.get('gender', null));
      allow delete: if isAdmin();
    }

    // Quem pode ver a lista acima: um doc por atleta inscrito (id = uid,
    // guarda o CPF da inscrição). A regra só conhece o uid de quem lê e a
    // inscrição é guardada pelo CPF — este doc é a ponte. O próprio atleta
    // se libera, desde que a inscrição dele exista e não esteja removida; o
    // admin mantém em dia (e tira quem foi removido).
    match /paduaViewers/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'cpf'])
        && request.resource.data.uid == uid
        && get(/databases/$(database)/documents/paduaRegistrations/$(request.resource.data.cpf)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/paduaRegistrations/$(request.resource.data.cpf)).data.status in ['pending', 'paid'];
      allow update, delete: if isAdmin();
    }

    // Academias — leitura pública, escrita só admin.
    match /academies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
